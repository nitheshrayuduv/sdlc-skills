{
  "schema_version": "1.0",
  "workspace_root": "~/work",
  "branch_prefix": "vuln/",
  "platform_repo": "xl-platform",
  "reference_paths": [
    "xl-reference"
  ],
  "version_files": [
    "dependencies.conf",
    "gradle.properties",
    "*.gradle",
    "*.gradle.kts",
    "*.properties",
    "*.conf"
  ],
  "build": {
    "command": [
      "./gradlew",
      "clean",
      "build",
      "-x",
      "test"
    ],
    "publish_command": [
      "./gradlew",
      "publishToMavenLocal"
    ],
    "timeout_seconds": 3600,
    "version_command": [
      "./gradlew",
      "-q",
      "properties"
    ],
    "version_timeout_seconds": 900
  },
  "transitive": {
    "command": [
      "./gradlew",
      "dependencyInsight",
      "--dependency",
      "{dependency}",
      "--configuration",
      "runtimeClasspath"
    ]
  },
  "handoff": [
    {
      "from": "xl-platform",
      "version_source": "gradle",
      "to": [
        {
          "repo": "central-configuration",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "deploy-central-configuration",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "deploy-permission-service",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "deploy-task-engine",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "xl-deploy",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "xl-satellite",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "xld-stitch-core",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        },
        {
          "repo": "deploy-cli",
          "file": "gradle/dependencies.conf",
          "key": "xlPlatformVersion"
        }
      ]
    },
    {
      "from": "central-configuration",
      "version_source": "gradle",
      "to": [
        {
          "repo": "deploy-task-engine",
          "file": "gradle/dependencies.conf",
          "key": "centralConfigurationVersion"
        },
        {
          "repo": "xl-deploy",
          "file": "gradle/dependencies.conf",
          "key": "centralConfigurationVersion"
        }
      ]
    },
    {
      "from": "deploy-task-engine",
      "version_source": "gradle",
      "to": [
        {
          "repo": "xl-deploy",
          "file": "gradle/dependencies.conf",
          "key": "deployTaskEngineVersion"
        },
        {
          "repo": "xl-satellite",
          "file": "gradle/dependencies.conf",
          "key": "deployTaskEngineVersion"
        },
        {
          "repo": "deploy-cli",
          "file": "gradle/dependencies.conf",
          "key": "deployTaskEngineVersion"
        }
      ]
    },
    {
      "from": "xl-deploy",
      "version_source": "gradle",
      "to": [
        {
          "repo": "deploy-cli",
          "file": "gradle/dependencies.conf",
          "key": "xlDeployVersion"
        }
      ]
    }
  ],
  "repo_overrides": {},
  "base_branch": {},
  "flows": {
    "deploy": {
      "publish": true,
      "repos": [
        "xl-platform",
        "central-configuration",
        "deploy-central-configuration",
        "deploy-permission-service",
        "xld-stitch-core",
        "deploy-task-engine",
        "xl-deploy",
        "xl-satellite",
        "overthere",
        "deploy-cli"
      ]
    },
    "release": {
      "publish": true,
      "repos": [
        "xl-platform",
        "xl-release"
      ]
    }
  }
}
